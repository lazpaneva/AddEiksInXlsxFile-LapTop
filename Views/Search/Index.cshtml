@model AddEiksInXlsxFile.Models.SearchViewModel
@using System
@{
    ViewData["Title"] = "Search";
    var file2Col = Model?.File2Col > 0 ? Model.File2Col : (int?)(ViewData["File2Col"] ?? 1);
    var previousPage = Math.Max(1, (Model?.CurrentPage ?? 1) - 1);
    var nextPage = Math.Min(Model?.TotalPages ?? 1, (Model?.CurrentPage ?? 1) + 1);
}

<div class="card">
    <div class="card-body">
        <h4>Search - редове с липсващ ЕИК (&quot;!!!!&quot;)</h4>

        @if (ViewData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        else if (string.IsNullOrEmpty(Model?.SourceFile))
        {
            <div class="alert alert-info">
                Няма намерен резултатен файл (*-result.xlsx). Първо качете и обработете файлове от страница
                <a href="/Upload">Upload</a>.
            </div>
        }
        else if (Model.Rows == null || Model.Rows.Count == 0)
        {
            <div class="alert alert-success">
                Файл <strong>@Model.SourceFile</strong> - всички редове имат попълнени ЕИК. Няма редове с "!!!!".
            </div>
        }
        else
        {
            <form id="searchForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="sourceFile" value="@Model.SourceFile" />
                <input type="hidden" name="file2Col" value="@file2Col" />

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        Редове @(((Model.CurrentPage - 1) * Model.PageSize) + 1)-@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRows)) от @Model.TotalRows
                    </div>
                    <nav aria-label="Страници">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { sourceFile = Model.SourceFile, file2Col, page = 1 })">Първа</a>
                            </li>
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { sourceFile = Model.SourceFile, file2Col, page = previousPage })">Предишна</a>
                            </li>
                            <li class="page-item active" aria-current="page">
                                <span class="page-link">@Model.CurrentPage / @Model.TotalPages</span>
                            </li>
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { sourceFile = Model.SourceFile, file2Col, page = nextPage })">Следваща</a>
                            </li>
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { sourceFile = Model.SourceFile, file2Col, page = Model.TotalPages })">Последна</a>
                            </li>
                        </ul>
                    </nav>
                </div>

                <div style="overflow-y:auto; max-height: calc(100vh - 160px);">
                    <table class="table table-sm table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:35%">Име на фирмата</th>
                                <th style="width:20%">ЕИК - попълни</th>
                                <th>Пълен ред (първи 35 символа)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                var searchTerm = Uri.EscapeDataString("\"" + row.CompanyName + "\"");
                                var url = "https://web.apis.bg/srch.php?dt=38&sr=" + searchTerm;
                                var detailsId = $"row-details-{row.RowNumber}";

                                <tr>
                                    <td><a target="_blank" rel="noopener" href="@url">@row.CompanyName</a></td>
                                    <td>
                                        <input type="text"
                                               name="edits[@row.RowNumber]"
                                               value="!!!!"
                                               data-original-value="!!!!"
                                               class="form-control form-control-sm"
                                               inputmode="numeric"
                                               pattern="(\d{9}|\d{10}|\d{13})?"
                                               maxlength="13"
                                               placeholder="9, 10 или 13 цифри" />
                                    </td>
                                    <td>
                                        <span>@row.TruncatedText</span>
                                        @if ((row.FullRowText?.Length ?? 0) > 35)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-link search-details-open"
                                                    data-details-target="@detailsId">
                                                Подробно
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" id="saveBtn" class="btn btn-primary">Запази промените</button>
                </div>
            </form>

            <div id="searchDetailsOverlay" class="search-details-overlay" hidden>
                <div class="search-details-window" role="dialog" aria-modal="true" aria-labelledby="searchDetailsTitle">
                    <div class="search-details-header">
                        <h5 id="searchDetailsTitle" class="mb-0">Пълен текст</h5>
                        <button type="button" class="search-details-x search-details-close" aria-label="Затвори">X</button>
                    </div>
                    <pre id="searchDetailsText" class="search-details-text"></pre>
                    <div class="search-details-footer">
                        <button type="button" class="btn btn-secondary search-details-close">Затвори</button>
                    </div>
                </div>
            </div>

            @foreach (var row in Model.Rows.Where(r => (r.FullRowText?.Length ?? 0) > 35))
            {
                var detailsId = $"row-details-{row.RowNumber}";
                <template id="@detailsId" data-title="Пълен текст - @row.CompanyName">@row.FullRowText</template>
            }
        }
    </div>
</div>

<style>
    .search-details-overlay[hidden] {
        display: none !important;
    }

    .search-details-overlay {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(17, 24, 39, .35);
    }

    .search-details-window {
        width: min(900px, 96vw);
        max-height: 82vh;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: .5rem;
        box-shadow: 0 18px 50px rgba(15, 23, 42, .25);
    }

    .search-details-header,
    .search-details-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .75rem 1rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .search-details-x {
        width: 2rem;
        height: 2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 1px solid #9ca3af;
        border-radius: .25rem;
        background: #fff;
        color: #111827;
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1;
    }

    .search-details-x:hover {
        background: #f3f4f6;
    }

    .search-details-footer {
        justify-content: flex-end;
        border-top: 1px solid #e5e7eb;
        border-bottom: 0;
    }

    .search-details-text {
        margin: 0;
        padding: 1rem;
        overflow: auto;
        white-space: pre-wrap;
        font-family: inherit;
        font-size: .95rem;
    }
</style>

@section Scripts {
    <script>
        const detailsOverlay = document.getElementById('searchDetailsOverlay');
        const detailsTitle = document.getElementById('searchDetailsTitle');
        const detailsText = document.getElementById('searchDetailsText');

        function closeDetails() {
            detailsOverlay?.setAttribute('hidden', '');
        }

        document.querySelectorAll('.search-details-open').forEach(button => {
            button.addEventListener('click', function () {
                const template = document.getElementById(this.dataset.detailsTarget);
                if (!template || !detailsOverlay || !detailsText || !detailsTitle) return;

                detailsTitle.textContent = template.dataset.title || 'Пълен текст';
                detailsText.textContent = template.content.textContent || '';
                detailsOverlay.removeAttribute('hidden');
            });
        });

        document.querySelectorAll('.search-details-close').forEach(button => {
            button.addEventListener('click', closeDetails);
        });

        detailsOverlay?.addEventListener('click', function (event) {
            if (event.target === detailsOverlay) closeDetails();
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') closeDetails();
        });

        document.getElementById('saveBtn')?.addEventListener('click', async function () {
            const form = document.getElementById('searchForm');
            if (!form) return;

            const fd = new FormData(form);
            const edits = {};
            for (const [key, value] of fd.entries()) {
                const match = key.match(/^edits\[(.*)\]$/);
                if (!match) continue;

                const input = form.querySelector(`[name="${CSS.escape(key)}"]`);
                if (!input || input.value === input.dataset.originalValue) continue;

                edits[match[1]] = value;
            }

            try {
                const resp = await fetch('/Search/SaveOperatorEdits', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': fd.get('__RequestVerificationToken')
                    },
                    body: JSON.stringify({
                        sourceFile: fd.get('sourceFile'),
                        file2Col: parseInt(fd.get('file2Col'), 10),
                        edits
                    })
                });

                const data = await resp.json();
                if (data.success) {
                    let msg = 'Записано: ' + data.filename + '\nПът: ' + data.path;
                    if (data.errors && data.errors.length) msg += '\nГрешки:\n' + data.errors.join('\n');
                    msg += '\n\u041f\u0440\u043e\u043c\u0435\u043d\u0435\u043d\u0438 \u0440\u0435\u0434\u043e\u0432\u0435 \u0441\u0435\u0433\u0430: ' + (data.changedRows ?? 0);
                    msg += '\n\u041e\u0431\u0449 \u0431\u0440\u043e\u0439 "!!!!" \u043f\u0440\u0435\u0434\u0438 \u0440\u0430\u0431\u043e\u0442\u0430: ' + (data.totalMissingRows ?? 0);
                    msg += '\n\u041e\u0431\u0440\u0430\u0431\u043e\u0442\u0435\u043d\u0438 "!!!!" \u0437\u0430 \u0444\u0430\u0439\u043b\u0430: ' + (data.processedRows ?? 0);
                    msg += '\n\u0423\u043d\u0438\u043a\u0430\u043b\u043d\u0438 \u0415\u0418\u041a \u043e\u0442 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430: ' + (data.uniqueEiksCount ?? 0);
                    alert(msg);
                } else {
                    alert('Записът не беше успешен.');
                }
            } catch (e) {
                alert('Грешка: ' + e);
            }
        });
    </script>
}

@model AddEiksInXlsxFile.Models.SearchViewModel
@using System
@{
    ViewData["Title"] = "Search";
    var file2Col = (int?)(ViewData["File2Col"] ?? 1);
}

<div class="card">
    <div class="card-body">
        <h4>Search — rows with missing EIK ("!!!!")</h4>
        @if (string.IsNullOrEmpty(Model?.SourceFile) || Model.Rows.Count == 0)
        {
            <div class="alert alert-info">No result file found or no rows with &quot;!!!!&quot;. Run processing first.</div>
        }
        else
        {
            <form id="searchForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="sourceFile" value="@Model.SourceFile" />
                <input type="hidden" name="file2Col" value="@file2Col" />

                <div style="overflow-y:auto; max-height: calc(100vh - 160px);">
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th style="width:35%">Име на фирмата</th>
                                <th style="width:20%">ЕИК</th>
                                <th>Пълен ред (първи 35 символа)</th>
                                <th style="width:12%">Попълване</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                var url = "https://web.apis.bg/srch.php?frt=1&tkn=" + Uri.EscapeDataString("\"" + row.CompanyName + "\"") + "&srfl=387&crypt=0&dt=38&d=4_4,&di=4&dispid=4&sr=%7Bquote%7D%D0%B0%D0%BF%D0%B8%D1%81+%D0%B5%D0%B2%D1%80%D0%BE%D0%BF%D0%B0%7Bquote%7D&rfil=0&tabs=56&start=0&end=0&cs=&spid=0&soid=0&scid=0&fcb=0&dist=0&fil=2&vsst=0";
                                <tr>
                                    <td><a target="_blank" href="@url">@row.CompanyName</a></td>
                                    <td><a target="_blank" href="@url">@row.Eik</a></td>
                                    <td>
                                        @row.TruncatedText
                                        @if ((row.FullRowText?.Length ?? 0) > 40)
                                        {
                                            <button type="button" class="btn btn-sm btn-link" data-bs-toggle="modal" data-bs-target="#modal-@row.RowNumber">Подробно</button>

                                            <div class="modal fade" id="modal-@row.RowNumber" tabindex="-1" aria-labelledby="modalLabel-@row.RowNumber" aria-hidden="true">
                                                <div class="modal-dialog modal-lg">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="modalLabel-@row.RowNumber">Пълен текст - @row.CompanyName</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <pre style="white-space:pre-wrap;">@row.FullRowText</pre>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Затвори</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <input type="text" name="edits[@row.RowNumber]" value="" class="form-control form-control-sm" placeholder="въведи ЕИК (9 или 12 цифри)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" id="saveBtn" class="btn btn-primary">Запази промените</button>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('saveBtn')?.addEventListener('click', async function () {
            const form = document.getElementById('searchForm');
            if (!form) return;
            const fd = new FormData(form);
            const obj = {};
            for (const [k, v] of fd.entries()) {
                if (k === '__RequestVerificationToken' || k === 'sourceFile' || k === 'file2Col') continue;
                // keys are like edits[ROWNUMBER]
                const m = k.match(/^edits\[(.*)\]$/);
                if (m) obj[m[1]] = v;
            }
            const token = fd.get('__RequestVerificationToken');
            const sourceFile = fd.get('sourceFile');
            const file2Col = fd.get('file2Col');

            try {
                const resp = await fetch('/Search/SaveOperatorEdits', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ sourceFile, file2Col: parseInt(file2Col), edits: obj })
                });
                const data = await resp.json();
                if (data.success) {
                    let msg = 'Записано: ' + data.filename + '\nПът: ' + data.path;
                    if (data.errors && data.errors.length) msg += '\nErrors:\n' + data.errors.join('\n');
                    alert(msg);
                } else {
                    alert('Save failed');
                }
            } catch (e) {
                alert('Error: ' + e);
            }
        });
    </script>
}

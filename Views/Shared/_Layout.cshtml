<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AddEiksInXlsxFile</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand brand" href="/">AddEiksInXlsxFile</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav align-items-center nav-center">
                    <li class="nav-item"><a class="nav-link" href="/Upload">Upload</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Search" id="searchBtn">Search</a></li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item">
                            <form method="post" action="/Account/Logout" class="d-flex">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link btn btn-primary text-white ms-3" href="/Account/Login">Log in</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4 app-main">
        <div class="row justify-content-center">
            <div class="col-12">
                <div class="card p-3"> 
                    @RenderBody()
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-white border-top mt-4 py-3">
        <div class="container d-flex justify-content-between small text-muted">
            <div>© @DateTime.Now.Year AddEiksInXlsxFile</div>
            <div>Built for XLSX EIK matching</div>
        </div>
    </footer>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

@model AddEiksInXlsxFile.Models.UploadResult
@{
    ViewData["Title"] = "Upload";
}

<div class="centered">
    <h2>Upload XLSX Files</h2>
    <p class="text-muted">Upload two XLSX files and specify which columns contain company names.</p>
</div>

<form asp-action="Index" method="post" enctype="multipart/form-data" class="small-gap">
    <div>
        <label for="file1" class="form-label">File 1 (contains EIKs)</label>
        <input class="form-control" type="file" id="file1" name="file1" accept=".xlsx" />
        <div class="form-text text-muted">@(Model?.File1Name ?? " ")</div>
        <span asp-validation-for="file1" class="text-danger"></span>
    </div>
    <input type="hidden" name="existingFile1" value="@(Model?.File1Name ?? "")" />

    <div>
        <label for="file2" class="form-label">File 2 (to populate)</label>
        <input class="form-control" type="file" id="file2" name="file2" accept=".xlsx" />
        <div class="form-text text-muted">@(Model?.File2Name ?? " ")</div>
        <span asp-validation-for="file2" class="text-danger"></span>
    </div>
    <input type="hidden" name="existingFile2" value="@(Model?.File2Name ?? "")" />

    <div class="centered">
        <button type="submit" name="submitButton" value="Upload" class="btn btn-secondary">Upload</button>
    </div>

    <div>
        <label for="file1Col" class="form-label">Company column in File 1 (1-based)</label>
        <input class="form-control" type="number" id="file1Col" name="file1Col" value="@(Model?.File1CompanyColumn ?? 1)" min="1" />
    </div>

    <div>
        <label for="file2Col" class="form-label">Company column in File 2 (1-based)</label>
        <input class="form-control" type="number" id="file2Col" name="file2Col" value="@(Model?.File2CompanyColumn ?? 1)" min="1" />
    </div>

    <div class="centered">
        <button type="submit" name="submitButton" value="Start" class="btn btn-start">Start</button>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="mt-3 alert alert-danger">
        <ul>
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@err.ErrorMessage</li>
            }
        </ul>
    </div>
}

@if (Model != null)
{
    <div class="mt-3">
        <h4 class="centered">Uploaded files</h4>
        <ul class="list-unstyled centered">
            @if (!string.IsNullOrEmpty(Model.File1Name))
            {
                <li>File 1: <a href="@Url.Action("Download", "Upload", new { file = Model.File1Name })">@Model.File1Name</a></li>
            }
            @if (!string.IsNullOrEmpty(Model.File2Name))
            {
                <li>File 2: <a href="@Url.Action("Download", "Upload", new { file = Model.File2Name })">@Model.File2Name</a></li>
            }
        </ul>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="mt-3 alert alert-info centered">@Model.Message</div>
        }
    </div>
}
